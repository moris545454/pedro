<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Araba Rüyası | Linkler</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Orbitron (Fütüristik bir font) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Orbitron', sans-serif;
            background-color: #000;
            overflow-x: hidden; /* Yatay kaydırmayı engelle */
        }

        /* JavaScript ile çizilen hareketli arka plan için kanvas */
        #neon-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }

        /* Neon Parlama Efektleri */
        .neon-glow-text-pink {
            text-shadow: 0 0 5px rgba(255, 255, 255, 0.8), 
                         0 0 10px rgba(255, 0, 221, 0.7), 
                         0 0 20px rgba(255, 0, 221, 0.6), 
                         0 0 30px rgba(255, 0, 221, 0.5);
        }
        .neon-glow-image {
            box-shadow: 0 0 5px rgba(255, 255, 255, 0.8), 
                        0 0 15px rgba(0, 255, 255, 0.7), 
                        0 0 25px rgba(0, 255, 255, 0.6), 
                        0 0 40px rgba(0, 255, 255, 0.5);
        }

        /* "Glassmorphism" Kart Stili (Neon versiyon) */
        .glass-card {
            background: rgba(0, 255, 255, 0.05);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(0, 255, 255, 0.3);
            transition: all 0.3s ease;
        }
        .glass-card:hover {
            background: rgba(0, 255, 255, 0.15);
            border-color: rgba(0, 255, 255, 0.8);
            transform: translateY(-5px) scale(1.03);
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.4);
        }

        /* Sayfa Yüklenirken Animasyon */
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease-out forwards;
        }
        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Buton için Parlama Animasyonu */
        .pulsate-glow {
            animation: pulsate 2.5s infinite ease-in-out;
        }
        @keyframes pulsate {
            0% { box-shadow: 0 0 20px rgba(255, 0, 221, 0.4); }
            50% { box-shadow: 0 0 35px rgba(255, 0, 221, 0.8); }
            100% { box-shadow: 0 0 20px rgba(255, 0, 221, 0.4); }
        }
    </style>
</head>
<body class="text-white">

    <canvas id="neon-canvas"></canvas>

    <main class="max-w-xl mx-auto p-4 py-8 md:py-12 relative z-10">
        
        <!-- PROFİL BİLGİLERİ -->
        <header class="text-center mb-10">
            <img 
                src="https://placehold.co/128x128/000000/00ffff?text=AR" 
                alt="Profil Fotoğrafı" 
                class="w-28 h-28 md:w-32 md:h-32 rounded-full mx-auto neon-glow-image fade-in-up"
                style="animation-delay: 0.1s;"
                onerror="this.onerror=null;this.src='https://placehold.co/128x128/cccccc/ffffff?text=Hata';"
            >
            
            <h1 class="text-2xl md:text-3xl font-bold mt-6 tracking-widest neon-glow-text-pink fade-in-up" style="animation-delay: 0.2s;">
                @arabaruyasi
            </h1>
            
            <p class="opacity-80 mt-2 text-cyan-200 fade-in-up" style="animation-delay: 0.3s;">
                Hayallerinizi süsleyen arabalar burada.
            </p>
        </header>

        <!-- ABONE OL BUTONU -->
        <section class="mb-10 fade-in-up" style="animation-delay: 0.4s;">
            <a id="subscribe-button" href="#" target="_blank" rel="noopener noreferrer" class="pulsate-glow block w-full text-center bg-pink-600/80 text-white font-bold py-3 px-6 rounded-lg shadow-lg hover:bg-pink-500 hover:scale-105 transform transition-all duration-300 border border-pink-400">
                KANALA KATIL
            </a>
        </section>

        <!-- VİDEO LİNKLERİ -->
        <div id="video-links-container" class="space-y-4">
            <div id="loading-indicator" class="text-center p-4 glass-card rounded-lg fade-in-up" style="animation-delay: 0.5s;">
                <p class="font-semibold text-cyan-200">Rüyalar yükleniyor...</p>
            </div>
        </div>

    </main>

    <script>
        // --- ✏️ DÜZENLEME ALANI ---

        // Kanalınızın ID'si. @arabaruyasi2 için doğru ID budur.
        const youtubeChannelId = 'UCV5L9z6a7d-n8_g_C0L_gQ'; 
        
        // Gösterilecek videoların ID'leri
        const videoIds = [
            'upj3fDZCbQ4',
            'IZmCHrrVBQs',
            'FJPA6WgDLg8'
        ];

        // --- KOD BÖLÜMÜ (Bu kısmı düzenlemenize gerek yok) ---
        
        // BÖLÜM 1: HAREKETLİ NEON ARKA PLAN KANVASI
        const canvas = document.getElementById('neon-canvas');
        const ctx = canvas.getContext('2d');
        let width, height, lines, stars;

        function init() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            lines = [];
            const lineCount = width * 0.1;
            for (let i = 0; i < lineCount; i++) {
                lines.push(new Line());
            }
            stars = [];
            const starCount = width * 0.2;
            for (let i = 0; i < starCount; i++) {
                stars.push(new Star());
            }
        }

        class Line {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.speed = Math.random() * 0.5 + 0.2;
                this.len = Math.random() * 2 + 1;
            }
            update() {
                this.y += this.speed;
                if (this.y > height) {
                    this.y = 0;
                    this.x = Math.random() * width;
                }
            }
            draw() {
                ctx.beginPath();
                ctx.moveTo(this.x, this.y);
                ctx.lineTo(this.x, this.y + this.len);
                ctx.strokeStyle = `rgba(0, 255, 255, ${this.speed * 0.8})`;
                ctx.lineWidth = 1;
                ctx.stroke();
            }
        }
        
        class Star {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.size = Math.random() * 1.5;
                this.speed = Math.random() * 0.2 + 0.1;
            }
            update() {
                this.y += this.speed;
                if (this.y > height) {
                    this.y = 0;
                    this.x = Math.random() * width;
                }
            }
            draw() {
                ctx.fillStyle = `rgba(255, 0, 221, ${this.speed * 1.5})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function animate() {
            ctx.clearRect(0, 0, width, height);
            
            const horizon = height * 0.4;
            const vanishingPointX = width / 2;
            ctx.strokeStyle = 'rgba(0, 255, 255, 0.3)';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(vanishingPointX, horizon);
            ctx.lineTo(0, height);
            ctx.moveTo(vanishingPointX, horizon);
            ctx.lineTo(width, height);
            ctx.stroke();

            lines.forEach(line => { line.update(); line.draw(); });
            stars.forEach(star => { star.update(); star.draw(); });
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', init);
        init();
        animate();

        // BÖLÜM 2: VİDEO VERİLERİNİ ÇEKME
        document.addEventListener('DOMContentLoaded', () => {
            const subscribeButton = document.getElementById('subscribe-button');
            if (youtubeChannelId) {
                subscribeButton.href = `https://www.youtube.com/channel/${youtubeChannelId}?sub_confirmation=1`;
            } else {
                subscribeButton.style.display = 'none';
            }
            fetchVideoDataAndCreateCards();
        });

        async function fetchVideoDataAndCreateCards() {
            const linksContainer = document.getElementById('video-links-container');
            const loadingIndicator = document.getElementById('loading-indicator');
            linksContainer.innerHTML = '';
            linksContainer.appendChild(loadingIndicator);

            let fetchedVideos = 0;
            for (const videoId of videoIds) {
                try {
                    const oEmbedUrl = `https://www.youtube.com/oembed?format=json&url=https://www.youtube.com/watch?v=${videoId}`;
                    const proxyUrl = `https://api.allorigins.win/raw?url=${encodeURIComponent(oEmbedUrl)}`;
                    const response = await fetch(proxyUrl);
                    if (!response.ok) throw new Error('Network response was not ok');
                    const data = await response.json();
                    createVideoCard(videoId, data.title, fetchedVideos);
                    fetchedVideos++;
                } catch (error) {
                    console.error('Video başlığı çekilemedi:', videoId, error);
                    createVideoCard(videoId, 'YouTube Videom', fetchedVideos);
                    fetchedVideos++;
                }
            }
             if (loadingIndicator) loadingIndicator.style.display = 'none';
        }

        function createVideoCard(videoId, title, index) {
            const linksContainer = document.getElementById('video-links-container');
            const videoUrl = `https://www.youtube.com/watch?v=${videoId}`;
            const thumbnailUrl = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;

            const card = document.createElement('a');
            card.href = videoUrl;
            card.target = '_blank';
            card.rel = 'noopener noreferrer';
            card.className = 'glass-card flex items-center p-3 w-full rounded-lg shadow-lg group fade-in-up';
            card.style.animationDelay = `${0.5 + index * 0.1}s`;

            card.innerHTML = `
                <img 
                    src="${thumbnailUrl}" 
                    alt="${title} kapak görseli" 
                    class="w-24 md:w-28 h-auto object-cover rounded-md mr-4 border-2 border-cyan-400/30 group-hover:border-cyan-400/80 transition-all"
                    onerror="this.onerror=null;this.src='https://placehold.co/480x360/000000/ffffff?text=HATA';"
                >
                <span class="flex-1 font-semibold text-cyan-200 text-sm md:text-base group-hover:text-white transition-colors">
                    ${title}
                </span>
                <svg class="w-6 h-6 text-cyan-400 opacity-0 group-hover:opacity-100 transition-opacity transform -translate-x-2 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 12h14"></path></svg>
            `;
            linksContainer.appendChild(card);
        }
    </script>
</body>
</html>
